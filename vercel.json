{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/admin/dashboard",
      "destination": "/api/control?route=admin/dashboard"
    },
    {
      "source": "/api/admin/dispatch",
      "destination": "/api/control?route=admin/dispatch"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/control?route=admin/login"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/control?route=admin/logout"
    },
    {
      "source": "/api/admin/schedule",
      "destination": "/api/control?route=admin/schedule"
    },
    {
      "source": "/api/admin/updates",
      "destination": "/api/control?route=admin/updates"
    },
    {
      "source": "/api/worker/config",
      "destination": "/api/control?route=worker/config"
    },
    {
      "source": "/api/worker/heartbeat",
      "destination": "/api/control?route=worker/heartbeat"
    },
    {
      "source": "/api/updates/active",
      "destination": "/api/control?route=updates/active"
    },
    {
      "source": "/api/camara-ceap",
      "destination": "/api/public-data?source=camara-ceap"
    },
    {
      "source": "/api/camara-deputados",
      "destination": "/api/public-data?source=camara-deputados"
    },
    {
      "source": "/api/camara-despesas",
      "destination": "/api/public-data?source=camara-despesas"
    },
    {
      "source": "/api/transferegov-emendas",
      "destination": "/api/public-data?source=transferegov-emendas"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https:; frame-src https:"
        }
      ]
    }
  ]
}
